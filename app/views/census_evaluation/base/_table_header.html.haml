-#  EEDS — Override de l'en-tête du tableau des effectifs (niveau Région/National).
-#  Ajoute les couleurs de branche EEDS aux colonnes.

- before_columns ||= []
- after_columns ||= []
- classes ||= nil

-# Couleurs par catégorie de branche EEDS
- branch_colors = { leiter: '#424242', woelfe: '#F9A825', pfadis: '#2E7D32', pios: '#333333', rover: '#C62828', pta: '#757575' }
- badge_styles = { pios: 'background: #FFFFFF; border: 2px solid #999; border-radius: 4px; padding: 2px 8px;' }

- category_count = MemberCount::COUNT_CATEGORIES.size

%table.table.table-striped{class: classes}
  %thead

    %tr
      - before_columns.each do |c|
        %th
      - MemberCount::COUNT_CATEGORIES.each do |c|
        %th.center{colspan: 2, style: "color: #{branch_colors[c] || '#333'}; font-weight: 600;"}
          %span{style: badge_styles[c] || ''}
            = t("activerecord.attributes.member_count.#{c}")
      %th.center{colspan: 3}= t('census_evaluation.total')
      - after_columns.each do |c|
        %th
    %tr
      - before_columns.each do |c|
        %th= c
      - category_count.times do
        %th.right= t('global.gender.female_short')
        %th.right= t('global.gender.male_short')
      %th.right= t('global.gender.female_short')
      %th.right= t('global.gender.male_short')
      %th.right= t('global.gender.female_short') + '+' + t('global.gender.male_short')
      - after_columns.each do |c|
        %th.right= c


  %tbody
    = yield
