- branche_colors = { "Mbootaay" => "#FCD116", "Kayon" => "#2ECC71", "Dental" => "#0054A0", "Galle" => "#E74C3C", "National" => "#5D4296", "Gilwell" => "#1e293b" }
- statut_config = { "en_attente" => { bg: "#f1f5f9", fg: "#94a3b8", label: "En attente" }, "partiel" => { bg: "#fef3c7", fg: "#f59e0b", label: "Partiel" }, "valide" => { bg: "#d1fae5", fg: "#10b981", label: "Validé" }, "expire" => { bg: "#fee2e2", fg: "#ef4444", label: "Expiré" }, "annule" => { bg: "#fecaca", fg: "#dc2626", label: "Annulé" } }

%table.maas-table
  %thead
    %tr
      %th Membre
      %th Branche
      %th Montant
      %th Payé
      %th Solde
      %th Statut
      %th Actions
  %tbody
    - subscriptions.each do |sub|
      - sc = statut_config[sub.statut] || statut_config["en_attente"]
      - bc = branche_colors[sub.membership_plan&.branche] || "#5D4296"
      %tr{onclick: "window.location='#{group_maas_adhesion_path(group, sub)}'"}
        %td{style: "font-weight: 600;"}= "#{sub.member.first_name} #{sub.member.last_name}"
        %td
          %span.maas-badge{style: "background: #{bc}20; color: #{bc};"}
            = sub.membership_plan&.branche
        %td= "#{sub.montant_total.to_i} FCFA"
        %td{style: "font-weight: 700; color: #10b981;"}= "#{sub.montant_paye.to_i}"
        %td{style: "color: #{sub.solde_restant > 0 ? '#f59e0b' : '#10b981'};"}
          = "#{sub.solde_restant.to_i}"
        %td
          %span.maas-badge{style: "background: #{sc[:bg]}; color: #{sc[:fg]};"}= sc[:label]
        %td
          - if sub.solde_restant > 0
            = link_to versement_group_maas_adhesion_path(group, sub), class: "maas-btn maas-btn-outline", style: "padding: 4px 12px; font-size: 11px;", onclick: "event.stopPropagation();" do
              💳 Versement
