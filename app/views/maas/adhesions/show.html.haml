- title "#{@subscription.member.first_name} #{@subscription.member.last_name} — Adhésion #{@subscription.membership_campaign.annee}"
- sc = statut_config[@subscription.statut] || statut_config["en_attente"]
- pct = @subscription.montant_total > 0 ? (@subscription.montant_paye * 100 / @subscription.montant_total).round : 0

:css
  .maas-detail { font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; }
  .maas-detail-header {
    background: linear-gradient(135deg, #5D4296 0%, #3a2870 100%);
    border-radius: 20px; padding: 28px 32px; color: #fff;
    position: relative; overflow: hidden;
  }
  .maas-detail-header .circle-d1 { position: absolute; top: -40px; right: -40px; width: 160px; height: 160px; border-radius: 50%; background: rgba(252,209,22,0.12); }
  .maas-detail-top { display: flex; align-items: center; gap: 20px; position: relative; z-index: 1; }
  .maas-detail-avatar { width: 56px; height: 56px; border-radius: 50%; background: rgba(255,255,255,0.15); display: flex; align-items: center; justify-content: center; font-size: 22px; font-weight: 700; border: 2px solid rgba(255,255,255,0.3); flex-shrink: 0; }
  .maas-detail-name { font-size: 20px; font-weight: 700; }
  .maas-detail-sub { font-size: 13px; opacity: 0.7; margin-top: 2px; }
  .maas-badge { padding: 4px 14px; border-radius: 20px; font-size: 11px; font-weight: 700; display: inline-block; }

  .maas-detail-grid { display: grid; grid-template-columns: 1fr 320px; gap: 20px; margin-top: 20px; }
  @media (max-width: 768px) { .maas-detail-grid { grid-template-columns: 1fr; } }

  .maas-card { background: #fff; border-radius: 14px; border: 1px solid rgba(93,66,150,0.08); box-shadow: 0 1px 4px rgba(0,0,0,0.04); overflow: hidden; }
  .maas-card-header { padding: 14px 20px; font-size: 14px; font-weight: 700; color: #1e293b; border-bottom: 1px solid rgba(93,66,150,0.06); display: flex; align-items: center; gap: 8px; }
  .maas-card-body { padding: 16px 20px; }

  .maas-info-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid rgba(93,66,150,0.04); font-size: 13px; }
  .maas-info-row:last-child { border-bottom: none; }
  .maas-info-label { color: #94a3b8; font-weight: 600; }
  .maas-info-value { color: #1e293b; font-weight: 600; }

  .maas-tx-item { display: flex; gap: 12px; padding: 12px 0; border-bottom: 1px solid rgba(93,66,150,0.04); }
  .maas-tx-item:last-child { border-bottom: none; }
  .maas-tx-dot { width: 10px; height: 10px; border-radius: 50%; margin-top: 5px; flex-shrink: 0; background: #10b981; }
  .maas-tx-content { flex: 1; }
  .maas-tx-amount { font-size: 16px; font-weight: 700; color: #10b981; }
  .maas-tx-meta { font-size: 11px; color: #94a3b8; margin-top: 2px; }

  .maas-progress-bar { width: 100%; height: 6px; border-radius: 6px; background: rgba(93,66,150,0.1); overflow: hidden; margin: 12px 0; }
  .maas-progress-fill { height: 100%; border-radius: 6px; transition: width 0.6s; }

  .maas-btn { padding: 8px 18px; border-radius: 10px; font-size: 12px; font-weight: 700; border: none; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
  .maas-btn-primary { background: linear-gradient(135deg, #5D4296, #7c5cbf); color: #fff; }
  .maas-btn-outline { background: #fff; border: 1.5px solid rgba(93,66,150,0.2); color: #5D4296; }
  .maas-btn-back { background: transparent; color: #5D4296; font-weight: 600; padding: 8px 0; font-size: 13px; text-decoration: none; }

.maas-detail
  = link_to group_maas_adhesions_path(@group), class: "maas-btn-back" do
    ← Retour aux adhésions

  .maas-detail-header
    .circle-d1
    .maas-detail-top
      .maas-detail-avatar= "#{@subscription.member.first_name[0]}#{@subscription.member.last_name[0]}"
      %div{style: "flex: 1;"}
        .maas-detail-name= "#{@subscription.member.first_name} #{@subscription.member.last_name}"
        .maas-detail-sub
          = "#{@subscription.membership_plan.branche} · Campagne #{@subscription.membership_campaign.annee}"
      %span.maas-badge{style: "background: #{sc[:bg]}; color: #{sc[:fg]};"}= sc[:label]

    %div{style: "margin-top: 16px; position: relative; z-index: 1;"}
      .maas-progress-bar
        .maas-progress-fill{style: "width: #{pct}%; background: #{pct >= 100 ? '#10b981' : '#f59e0b'};"}
      %div{style: "display: flex; justify-content: space-between; font-size: 12px; opacity: 0.8;"}
        %span= "#{@subscription.montant_paye.to_i} FCFA payé"
        %span= "#{@subscription.solde_restant.to_i} FCFA restant"

  .maas-detail-grid
    -# LEFT — Transactions
    %div
      .maas-card
        .maas-card-header 💳 Historique des versements (#{@transactions.count})
        .maas-card-body
          - if @transactions.any?
            - @transactions.each do |tx|
              .maas-tx-item
                .maas-tx-dot
                .maas-tx-content
                  .maas-tx-amount= "+#{tx.montant.to_i} FCFA"
                  .maas-tx-meta
                    = "#{t("maas.paiement.modalites.#{tx.modalite}")} · #{l(tx.created_at, format: :short)}"
                    - if tx.reference_manuelle.present?
                      = " · Réf: #{tx.reference_manuelle}"
                    %br
                    = "Par #{tx.enregistre_par.first_name} #{tx.enregistre_par.last_name}"
                    - if tx.notes.present?
                      %br
                      %em= tx.notes
          - else
            %p{style: "color: #94a3b8; text-align: center; padding: 20px;"}
              Aucun versement enregistré

      - if @subscription.solde_restant > 0
        %div{style: "margin-top: 14px;"}
          = link_to versement_group_maas_adhesion_path(@group, @subscription), class: "maas-btn maas-btn-primary" do
            💳 Enregistrer un versement

    -# RIGHT — Info
    .maas-card
      .maas-card-header ℹ️ Détails
      .maas-card-body
        .maas-info-row
          .maas-info-label Campagne
          .maas-info-value= @subscription.membership_campaign.annee
        .maas-info-row
          .maas-info-label Branche
          .maas-info-value= @subscription.membership_plan.branche
        .maas-info-row
          .maas-info-label Montant total
          .maas-info-value= "#{@subscription.montant_total.to_i} FCFA"
        .maas-info-row
          .maas-info-label Montant payé
          .maas-info-value{style: "color: #10b981;"}= "#{@subscription.montant_paye.to_i} FCFA"
        .maas-info-row
          .maas-info-label Solde restant
          .maas-info-value{style: "color: #{@subscription.solde_restant > 0 ? '#f59e0b' : '#10b981'};"}
            = "#{@subscription.solde_restant.to_i} FCFA"
        .maas-info-row
          .maas-info-label Assurance
          .maas-info-value= @subscription.assurance_active? ? "✓ Active" : "✗ Inactive"
        .maas-info-row
          .maas-info-label Expire le
          .maas-info-value= @subscription.expires_at ? l(@subscription.expires_at, format: :short) : "—"
        .maas-info-row
          .maas-info-label Groupe
          .maas-info-value= @subscription.group.name
